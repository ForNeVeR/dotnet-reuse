<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageDescription>.NET library to interact with license information in REUSE-compliant sources.</PackageDescription>
        <IsPackable>true</IsPackable>
    </PropertyGroup>

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="GitignoreParserNet" Version="0.2.0.15" />
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
        <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.11" />
        <PackageReference Include="TruePath" Version="1.12.0" />
        <PackageReference Include="TruePath.SystemIo" Version="1.12.0" />
    </ItemGroup>

</Project>
